# Example environment variables for the database container and ingestion tools

# Database runtime (used by startup.sh/healthcheck.sh if exported)
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_PORT=5000

# Optional: enable the Node.js viewer (NOT recommended in this container)
# Keep false by default; the viewer should run in a separate process/container.
ENABLE_DB_VIEWER=false

# Ingestion (run outside or within a job container; do not commit real values)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
