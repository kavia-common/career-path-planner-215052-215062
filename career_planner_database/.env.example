# Sample environment for career_planner_database
# This file is for local development only. Do NOT commit secrets to version control.

# Database configuration (used by startup.sh and healthcheck.sh)
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_PORT=5000

# Viewer is disabled by default and is NEVER started from this container.
# To use the optional Node.js viewer, run it manually from db_visualizer in a separate process/container.
ENABLE_DB_VIEWER=false

# Defensive flag to prevent orchestrators from chaining node viewer commands after startup.sh.
# Keep this as true in this container to avoid accidental chained executions.
DISABLE_CHAINED_CMDS=true
