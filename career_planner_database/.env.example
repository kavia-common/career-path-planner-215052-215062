# Example environment variables for the database container (do not commit secrets)
# These mirror the defaults in startup.sh and healthcheck.sh

DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_PORT=5000

# Viewer is disabled by default and NEVER started from this container.
# If you choose to run the viewer in a separate process/container, set this there.
ENABLE_DB_VIEWER=false
