# Environment variables for career_planner_database container (Supabase-based)
# Request these values from your Supabase project and set them in the actual .env (do not commit secrets)

# PUBLIC_INTERFACE
# SUPABASE project REST URL (e.g., https://<project-ref>.supabase.co)
SUPABASE_URL=

# PUBLIC_INTERFACE
# Supabase service role key (required for admin upserts and bypassing RLS in ingestion)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: attachments directory override for ingestion
ATTACHMENTS_DIR=../../attachments
