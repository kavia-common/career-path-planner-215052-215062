# Environment example for the database container
# These are defaults; orchestrators should not chain commands after startup.sh.

# Database basics
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_PORT=5000

# Defensive guards (do not change in this container)
ENABLE_DB_VIEWER=false
RUN_IN_SEPARATE_CONTAINER=false
DISABLE_CHAINED_CMDS=true
