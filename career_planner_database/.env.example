# PUBLIC_INTERFACE
# Example environment variables for the database container.
# Copy to .env and adjust as needed. Secrets should be set by the orchestrator.

# PostgreSQL runtime
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_PORT=5000

# Optional local-only viewer flag (never starts inside this container)
ENABLE_DB_VIEWER=false

# Ingestion (used by ingestion/ingest.py)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
