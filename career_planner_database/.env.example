# Example environment for career_planner_database
# PUBLIC_INTERFACE
# Copy to .env and adjust as needed. Do not commit real secrets.

# Database name and app user credentials (development defaults)
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123

# Dynamic port support: platform may inject one of these.
# startup.sh will use the first non-empty of: DATABASE_PORT, DB_PORT, PORT; fallback 5000.
# For local dev, you can set PORT=5432 or 5000.
PORT=5000
# DB_PORT=
# DATABASE_PORT=

# Keep the container alive after readiness (recommended on preview platforms)
KEEP_ALIVE=true

# Viewer is disabled inside this container regardless of flags.
ENABLE_DB_VIEWER=false
DISABLE_CHAINED_CMDS=true
